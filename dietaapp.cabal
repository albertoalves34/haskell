cabal-version:       2.4
name:                dietaapp
version:             0.1.0.0
synopsis:            Aplicativo de dieta com Haskell
license:             MIT
author:              Alberto
maintainer:          alberto@email.com

common warnings
    ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints

executable dietaapp
    import:           warnings
    main-is:          main.hs
    other-modules:    Banco, Routes
    build-depends:    base >=4.16 && <5,
                      scotty >=0.20,
                      wai >=3.2,
                      http-types >=0.12,
                      aeson >=2.0,
                      text >=1.2,
                      bytestring >=0.11
    hs-source-dirs:   .
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N
