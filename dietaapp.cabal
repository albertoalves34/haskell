cabal-version:      2.4
name:               dietaapp
version:            0.1.0.0

executable dietaapp
    main-is:          server.hs
    
    -- Dependências do projeto, incluindo as novas do web server
    build-depends:    base >=4.14 && <5,
                      scotty,
                      aeson,
                      wai-cors
                      
    ghc-options:      -threaded
    default-language: Haskell2010
